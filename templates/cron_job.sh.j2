#!/bin/bash
# Cron Job for Data Product: {{ data_product_name }}
# Generated by Agentic Data Product Builder
# Schedule: {{ cron_schedule }}

set -e

# Configuration
DATA_PRODUCT_ID="{{ data_product_id }}"
DATA_PRODUCT_VERSION="{{ version }}"
EXECUTION_DATE=$(date +%Y-%m-%d)
LOG_FILE="{{ log_dir }}/{{ data_product_name }}_${EXECUTION_DATE}.log"
PROJECT_ROOT="{{ project_root }}"

# Ensure log directory exists
mkdir -p "{{ log_dir }}"

{
    echo "=========================================="
    echo "Data Product: {{ data_product_name }}"
    echo "Execution Date: ${EXECUTION_DATE}"
    echo "Started at: $(date)"
    echo "=========================================="
    
    # Step 1: Validate source data freshness
    echo ""
    echo "[1/4] Validating source data freshness..."
    python3 "${PROJECT_ROOT}/src/utils/validate_sources.py" \
        --datasets {{ source_datasets | join(',') }}
    
    if [ $? -ne 0 ]; then
        echo "❌ Source validation failed"
        exit 1
    fi
    echo "✅ Source validation passed"
    
    # Step 2: Execute transformation
    echo ""
    echo "[2/4] Executing transformation..."
    {% if transformation_language == 'SQL' %}
    duckdb {{ database_path }} < "${PROJECT_ROOT}/{{ sql_file_path }}"
    {% elif transformation_language == 'PySpark' %}
    spark-submit "${PROJECT_ROOT}/{{ pyspark_file_path }}"
    {% endif %}
    
    if [ $? -ne 0 ]; then
        echo "❌ Transformation failed"
        exit 1
    fi
    echo "✅ Transformation completed"
    
    # Step 3: Run quality checks
    echo ""
    echo "[3/4] Running quality checks..."
    python3 "${PROJECT_ROOT}/src/utils/quality_check.py" \
        --data-product-id "${DATA_PRODUCT_ID}" \
        --target-table "{{ target_table }}"
    
    if [ $? -ne 0 ]; then
        echo "❌ Quality checks failed"
        exit 1
    fi
    echo "✅ Quality checks passed"
    
    # Step 4: Update registry
    echo ""
    echo "[4/4] Updating registry..."
    curl -X POST "{{ registry_url }}/api/v1/registry/data-products/${DATA_PRODUCT_ID}/executions" \
        -H "Content-Type: application/json" \
        -d "{
            \"version\": \"${DATA_PRODUCT_VERSION}\",
            \"status\": \"success\",
            \"execution_date\": \"${EXECUTION_DATE}\"
        }"
    
    echo ""
    echo "=========================================="
    echo "✅ Execution completed successfully"
    echo "Finished at: $(date)"
    echo "=========================================="
    
} >> "$LOG_FILE" 2>&1

# Check exit status
if [ $? -eq 0 ]; then
    echo "✅ Data product execution successful. Log: $LOG_FILE"
    exit 0
else
    echo "❌ Data product execution failed. Check log: $LOG_FILE"
    exit 1
fi
